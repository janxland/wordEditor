{
  "name": "wordeditor-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:python": "py -m uvicorn app:app --app-dir ../../services/api-python --reload --port 8787",
    "dev:backend": "pnpm --dir ../../services/api-node dev",
    "dev:node": "pnpm dev:backend",
    "dev:full": "pnpm dev:backend & pnpm dev",
    "dev:full:python": "pnpm dev:python & pnpm dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@monaco-editor/react": "^4.6.0",
    "antd": "^5.0.0",
    "docx-preview": "^0.3.7",
    "jszip": "^3.10.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.22.0",
    "yaml": "^2.3.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
